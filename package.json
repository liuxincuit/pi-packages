{
  "name": "@liuxincuit/pi-kit",
  "version": "0.1.0",
  "private": true,
  "description": "一套 pi 扩展、技能与提示词的合集，一条命令装齐",
  "keywords": [
    "pi-package",
    "kit"
  ],
  "license": "MIT",
  "author": "liuxincuit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuxincuit/pi-packages.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "files": [
    "extensions/",
    "!extensions/**/*.test.mts",
    "!extensions/codegraph/docs/",
    "!extensions/codegraph/smoke.mjs",
    "!extensions/codegraph/tsconfig.json",
    "!extensions/codegraph/AGENTS.md",
    "!extensions/codegraph/CONTEXT.md",
    "skills/",
    "prompts/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "test": "node --test \"extensions/**/*.test.mts\""
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
