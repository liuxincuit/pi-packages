  "keywords": [
    "pi-package",
    "agents-md",
    "context",
    "claude-md"
  ],
  "license": "MIT",
  "author": "liuxincuit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuxincuit/pi-packages.git",
    "directory": "packages/subdir-context"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "LICENSE",
    "README.md"
